{
  "name": "notion-exporter",
  "version": "0.1.0",
  "description": "CLI that backs up a Notion workspace locally: full-fidelity JSON + Markdown + HTML + assets",
  "license": "MIT",
  "author": "Daniel Metzner",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmetzner/notion-exporter.git"
  },
  "homepage": "https://github.com/dmetzner/notion-exporter",
  "bugs": "https://github.com/dmetzner/notion-exporter/issues",
  "keywords": [
    "notion",
    "notion-backup",
    "backup",
    "archive",
    "export",
    "markdown",
    "obsidian",
    "static-site",
    "html",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "notion-exporter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "contrast": "tsx scripts/contrast-check.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm contrast"
  },
  "dependencies": {
    "@notionhq/client": "^5.27.0",
    "bottleneck": "^2.19.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.6",
    "katex": "^0.19.0",
    "lunr": "^2.3.9",
    "marked": "^18.1.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "undici": "8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/katex": "^0.16.8",
    "@types/lunr": "^2.3.7",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
