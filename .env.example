# === Core ===
# Required. Notion integration token (https://www.notion.so/my-integrations).
NOTION_TOKEN=

# Output directory for stamped export folders.
# OUT_DIR=./exports

# Keep only the last N exports (0 = keep all).
# RETENTION=0

# Log verbosity: trace, debug, info, warn, error.
# LOG_LEVEL=info

# === Output ===
# Title shown in sidebar + browser tab.
# EXPORT_TITLE="Your Notion archive"

# Workspace icon — emoji glyph OR public URL OR html-root-relative path.
# EXPORT_ICON=📚

# Style "↩️ Back to …" paragraphs as pill buttons (personal convention).
# STYLE_BACK_LINKS=false

# Pretty-print raw JSON (slower I/O, larger files). Set false for huge workspaces.
# PRETTY_RAW_JSON=true

# Download per-row DB cover/icon images. Set false for big media-heavy DBs.
# EXPORT_ROW_MEDIA=true

# Database view layout: auto | table | kanban.
# auto = kanban when grouped by status/select, otherwise table.
# EXPORT_DB_VIEW=auto

# Walk block tree to discover subpages not returned by Notion search.
# Only set false when you know search already returns everything.
# EXPAND_CHILD_PAGES=true

# === Performance ===
# Worker pool sizes.
# PAGE_CONCURRENCY=4
# ASSET_CONCURRENCY=16
# CRAWL_CONCURRENCY=8

# === Notion API rate limiting ===
# Minimum ms between Notion API calls (per-token Bottleneck spacing).
# NOTION_MIN_TIME=150

# Max concurrent in-flight Notion API requests.
# NOTION_MAX_CONCURRENT=4

# Max retries for 429 / 5xx responses before giving up.
# NOTION_MAX_RETRIES=8
